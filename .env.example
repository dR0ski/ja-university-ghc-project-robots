# --- Flask runtime ---
# One of: development | testing | production
FLASK_ENV=development
# REQUIRED IN PROD. Min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-not-secret-change-me-change-me-change

# --- Database (REQUIRED IN PROD) ---
# psycopg3 dialect
DATABASE_URL=postgresql+psycopg://robot:robot@db:5432/robot
POSTGRES_USER=robot
POSTGRES_PASSWORD=robot
POSTGRES_DB=robot

# --- Redis (rate limiter storage; REQUIRED IN PROD) ---
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# --- Reverse proxy ---
# Number of trusted proxies in front of the app (e.g. 1 for a single load balancer).
# Drives ProxyFix configuration. Set to 0 to disable.
TRUSTED_PROXY_COUNT=0

# --- Logging ---
LOG_LEVEL=INFO
# true in prod, false in dev (human-readable)
LOG_JSON=false

# --- Observability (optional) ---
# Leave blank to disable Sentry.
SENTRY_DSN=
RELEASE=

# --- Feature flags ---
# Enable haveibeenpwned k-anonymity check on register (optional).
HIBP_ENABLED=false

# --- Gunicorn (prod) ---
WEB_CONCURRENCY=
